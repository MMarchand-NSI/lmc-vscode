{
  "name": "lmc-vscode",
  "displayName": "LMC — teaching assembly language",
  "description": "The LMC assembly language: diagnostics, completion, formatting and a step-through emulator. A teaching tool, in French, English, Spanish, Japanese or Korean.",
  "version": "0.1.2",
  "publisher": "mmarchand",
  "repository": {
    "type": "git",
    "url": "https://github.com/MMarchand-NSI/lmc-vscode.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Education"
  ],
  "main": "./out/client.js",
  "contributes": {
    "languages": [
      {
        "id": "lmc",
        "aliases": [
          "LMC",
          "Little Man Computer"
        ],
        "extensions": [
          ".lmc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lmc",
        "scopeName": "source.lmc",
        "path": "./syntaxes/lmc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lmc.openEmulator",
        "title": "LMC: Open Emulator",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lmc.openEmulator",
          "when": "editorLangId == lmc",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "LMC",
      "properties": {
        "lmc.locale": {
          "type": "string",
          "enum": [
            "fr",
            "en",
            "es",
            "ja",
            "ko",
            "auto"
          ],
          "enumDescriptions": [
            "French.",
            "English.",
            "Spanish.",
            "Japanese.",
            "Korean.",
            "Follow VS Code's display language, and fall back to English when the extension does not speak it. This is the default. Note that VS Code's display language stays English for most people whatever their country, so pick a language explicitly if you teach in one."
          ],
          "default": "auto",
          "description": "Language of the diagnostics, hover, completion and the emulator panel. \"auto\" follows VS Code's display language, which is what a first install gets; set it explicitly to teach in a language other than the one your editor is in, which is the common case in a classroom. The server restarts when this changes, since the language is announced when it starts."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node ../scripts/build-webview.mjs",
    "smoke": "node ../scripts/smoke-webview.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "lmc",
    "little man computer",
    "assembly",
    "education",
    "teaching",
    "emulator",
    "nsi",
    "assembler"
  ],
  "bugs": {
    "url": "https://github.com/MMarchand-NSI/lmc-vscode/issues"
  },
  "homepage": "https://github.com/MMarchand-NSI/lmc-vscode#readme",
  "galleryBanner": {
    "color": "#12121a",
    "theme": "dark"
  }
}
