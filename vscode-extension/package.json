{
  "name": "lmc-vscode",
  "displayName": "LMC Language Support",
  "description": "Little Man Computer (LMC) assembly language support for VS Code",
  "version": "0.1.0",
  "publisher": "lmc-vscode",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/client.js",
  "contributes": {
    "languages": [
      {
        "id": "lmc",
        "aliases": [
          "LMC",
          "Little Man Computer"
        ],
        "extensions": [
          ".lmc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lmc",
        "scopeName": "source.lmc",
        "path": "./syntaxes/lmc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lmc.openEmulator",
        "title": "LMC: Open Emulator",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lmc.openEmulator",
          "when": "editorLangId == lmc",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node ../scripts/build-webview.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.109.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
