{
  "name": "lmc-vscode",
  "displayName": "LMC — assembleur pédagogique",
  "description": "Le langage d'assemblage LMC : diagnostics, complétion, formatage et un émulateur pas à pas. Outil de cours, en français.",
  "version": "0.1.0",
  "publisher": "lmc-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/MMarchand-NSI/lmc-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/client.js",
  "contributes": {
    "languages": [
      {
        "id": "lmc",
        "aliases": [
          "LMC",
          "Little Man Computer"
        ],
        "extensions": [
          ".lmc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lmc",
        "scopeName": "source.lmc",
        "path": "./syntaxes/lmc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lmc.openEmulator",
        "title": "LMC : ouvrir l'émulateur",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lmc.openEmulator",
          "when": "editorLangId == lmc",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "LMC",
      "properties": {
        "lmc.locale": {
          "type": "string",
          "enum": [
            "fr",
            "en",
            "es",
            "auto"
          ],
          "enumDescriptions": [
            "Français.",
            "English.",
            "Español.",
            "Suivre la langue d'affichage de VS Code. À n'utiliser que si elle est effectivement réglée : elle reste en anglais chez la plupart des gens, quel que soit leur pays."
          ],
          "default": "fr",
          "description": "Langue des diagnostics, des survols et de la complétion. Le défaut est le français, parce que la langue de VS Code n'indique pas la langue de la classe. Le serveur redémarre au changement, la langue étant annoncée à son démarrage."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node ../scripts/build-webview.mjs",
    "smoke": "node ../scripts/smoke-webview.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
