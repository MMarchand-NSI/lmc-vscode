{
  "name": "lmc-vscode",
  "displayName": "LMC — teaching assembly language",
  "description": "The LMC assembly language: diagnostics, completion, formatting and a step-through emulator. A teaching tool, in French, English or Spanish.",
  "version": "0.1.0",
  "publisher": "lmc-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/MMarchand-NSI/lmc-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/client.js",
  "contributes": {
    "languages": [
      {
        "id": "lmc",
        "aliases": [
          "LMC",
          "Little Man Computer"
        ],
        "extensions": [
          ".lmc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lmc",
        "scopeName": "source.lmc",
        "path": "./syntaxes/lmc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lmc.openEmulator",
        "title": "LMC: Open Emulator",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lmc.openEmulator",
          "when": "editorLangId == lmc",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "LMC",
      "properties": {
        "lmc.locale": {
          "type": "string",
          "enum": [
            "fr",
            "en",
            "es",
            "auto"
          ],
          "enumDescriptions": [
            "French.",
            "English.",
            "Spanish.",
            "Follow VS Code's display language. Only useful if you have actually set it: it stays English for most people whatever their country."
          ],
          "default": "fr",
          "description": "Language of the diagnostics, hover, completion and the emulator panel. French by default, because VS Code's display language is a poor guess at the language of a classroom. The server restarts when this changes, since the language is announced when it starts."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "node ../scripts/build-webview.mjs",
    "smoke": "node ../scripts/smoke-webview.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "1.80.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
