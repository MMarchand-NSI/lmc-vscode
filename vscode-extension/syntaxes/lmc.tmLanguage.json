{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LMC",
  "scopeName": "source.lmc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#labels" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lmc",
          "match": "//.*$"
        },
        {
          "name": "comment.line.semicolon.lmc",
          "match": ";.*$"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lmc",
          "match": "-?\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lmc",
          "match": "(?i)\\b(ADD|SUB|STA|LDA|BRA|BRZ|BRP|INP|OUT|HLT|DAT)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.lmc",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
