// Parcours d'un tableau avec l'adressage indexé.
//
// Le suffixe [SI] ajoute le contenu du registre SI à l'adresse écrite :
// lst[SI] désigne la case lst + SI. C'est ce qui permet d'écrire une seule
// instruction pour lire n'importe quelle case du tableau.
//
// Affiche chaque élément, puis leur somme.

        LDA zero
        STA i
        STA total

boucle: LDA i
        SUB n           // i - n : nul quand le tableau est épuisé
        BRZ fin

        LDA i
        MOV SI, ACC     // SI <- i ; LDA ne sait pas nommer SI, MOV oui
        LDA lst[SI]     // ACC <- mem[lst + i]
        OUT

        ADD total       // total = total + lst[i]
        STA total

        LDA i           // i = i + 1
        ADD un
        STA i
        BRA boucle

fin:    LDA total
        OUT
        HLT

lst:    DAT 12, 4, 86, 7    // une ligne, quatre cases ; lst désigne la première
n:      DAT 4
i:      DAT
total:  DAT
zero:   DAT 0
un:     DAT 1
